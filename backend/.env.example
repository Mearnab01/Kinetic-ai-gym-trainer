# Supabase project shared with Project 1 (or a dedicated one) — anon/public key only.
# NEVER put the service-role key here or in any frontend-visible file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_DB_PASSWORD=your-supabase-db-password

# Comma-separated list of allowed origins for CORS (the Vite dev server / deployed frontend)
FRONTEND_ORIGIN=http://localhost:5173
GROQ_API_KEY=your-groq-api-key
